{
  "name": "cyl-sense",
  "version": "0.1.0",
  "private": true,
  "description": "CYL Sense - coaching inteligente para gamers (desktop Windows, local-first).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @cyl/desktop tauri dev",
