{
  "name": "@cyl/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "CYL Sense API: autenticacao, integracao Riot (desativada sem aprovacao), sincronizacao e servicos compartilhados.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:demo": "tsx watch --env-file=.env.mock src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cyl/contracts": "workspace:*",
    "@cyl/core": "workspace:*",
    "@cyl/game-adapter-valorant": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "fastify": "^5.6.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@cyl/config": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
