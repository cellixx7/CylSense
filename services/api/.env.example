# Copie para .env (nunca versionado). Nenhuma variavel e obrigatoria em desenvolvimento.

# development | test | production
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# disabled (padrao): integracao Riot desligada, nenhuma chamada externa.
# mock: login e partidas SINTETICAS para desenvolvimento/demonstracao. Recusado com NODE_ENV=production.
CYL_AUTH_MODE=disabled

# Origem do CYL Sense Web (destino dos redirects apos login).
CYL_WEB_ORIGIN=http://localhost:3000

# URL publica desta API vista pelo navegador (usada no redirect_uri do OAuth).
# Em desenvolvimento o web encaminha /api/* para a API, entao usamos a origem do web.
CYL_PUBLIC_API_URL=http://localhost:3000/api

# Pasta das fixtures sinteticas usadas pelo modo mock (padrao: fixtures/valorant do repositorio).
# CYL_FIXTURES_DIR=
